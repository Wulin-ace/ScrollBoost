{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scrollboost",
  "main": "./src/index.js",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}
